{
    "localize": {
        "LocalizePreloadingHubs": "31132",
        "LocalizeLoadingWidgets": "31133"
    },
    "values": {
        "301Updating": [
            {
                "rules": [
                    "Container(301).IsUpdating",
                    "[Integer.IsEqual(Container(301).NumItems,0) | [Integer.IsEqual(Container(301).NumItems,1) + String.IsEqual(Container(301).ListItemAbsolute(0).Label,$LOCALIZE[31046])]]"
                ],
                "value": "True"
            },
            ""
        ],
        "501Updating": [
            {
                "rules": [
                    "Container(501).IsUpdating",
                    "[Integer.IsEqual(Container(501).NumItems,0) | [Integer.IsEqual(Container(501).NumItems,1) + String.IsEqual(Container(501).ListItemAbsolute(0).Label,$LOCALIZE[31046])]]"
                ],
                "value": "True"
            },
            ""
        ]
    },
    "actions": [
        {
            "rules": [
                "String.IsEmpty(Window(Home).Property(HasPreloadedHubs))",
                "Skin.HasSetting(Startup.EnableHubPreloading)",
                "!Skin.HasSetting(Startup.DisableWaitForLoad)"
            ],
            "value": [
                "SetProperty(InitStatus,{LocalizePreloadingHubs},1198)",
                "SetProperty(SplashIsVisible,True,1198)",
                "SetProperty(HasPreloadedHubs,True,Home)",
                [
                    {
                        "rules": ["!String.IsEmpty(Skin.String(HomeSwitcher.1101.Toggle)) + $EXP[Exp_Hub_1101_Available]"],
                        "value": ["ActivateWindow(1101)", "sleep=0.3"]

                    }
                ],
                [
                    {
                        "rules": ["!String.IsEmpty(Skin.String(HomeSwitcher.1102.Toggle)) + $EXP[Exp_Hub_1102_Available]"],
                        "value": ["ActivateWindow(1102)", "sleep=0.3"]

                    }
                ],
                [
                    {
                        "rules": ["!String.IsEmpty(Skin.String(HomeSwitcher.1103.Toggle)) + $EXP[Exp_Hub_1103_Available]"],
                        "value": ["ActivateWindow(1103)", "sleep=0.3"]

                    }
                ],
                [
                    {
                        "rules": ["!String.IsEmpty(Skin.String(HomeSwitcher.1104.Toggle)) + $EXP[Exp_Hub_1104_Available]"],
                        "value": ["ActivateWindow(1104)", "sleep=0.3"]

                    }
                ],
                [
                    {
                        "rules": ["!String.IsEmpty(Skin.String(HomeSwitcher.1106.Toggle)) + $EXP[Exp_Hub_1106_Available]"],
                        "value": ["ActivateWindow(1106)", "sleep=0.3"]

                    }
                ],
                [
                    {
                        "rules": ["!String.IsEmpty(Skin.String(HomeSwitcher.1107.Toggle)) + $EXP[Exp_Hub_1107_Available]"],
                        "value": ["ActivateWindow(1107)", "sleep=0.3"]

                    }
                ],
                [
                    {
                        "rules": ["!String.IsEmpty(Skin.String(HomeSwitcher.1108.Toggle)) + $EXP[Exp_Hub_1108_Available]"],
                        "value": ["ActivateWindow(1108)", "sleep=0.3"]

                    }
                ],
                [
                    {
                        "rules": ["!String.IsEmpty(Skin.String(HomeSwitcher.1109.Toggle)) + $EXP[Exp_Hub_1109_Available]"],
                        "value": ["ActivateWindow(1109)", "sleep=0.3"]

                    }
                ],
                "ActivateWindow(Home)"
            ]
        },
        {
            "rules": [
                "!Skin.HasSetting(Startup.DisableWaitForLoad)",
                "System.HasVisibleModalDialog||{301Updating}!=||{501Updating}!=",
                "System.HasAlarm(SplashTimeOut)"
            ],
            "value": [
                "SetProperty(SplashIsVisible,True,1198)",
                "SetProperty(InitStatus,{LocalizeLoadingWidgets},1198)",
                "sleep=0.5",
                "route=run_executebuiltin=special://skin/shortcuts/skinvariables-splash.json&use_rules=True"
            ]
        },
        "sleep=0.5",
        "ClearProperty(SplashIsVisible,1198)",
        "CancelAlarm(SplashTimeOut,silent)"
    ]

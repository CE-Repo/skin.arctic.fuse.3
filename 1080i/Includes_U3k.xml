<?xml version="1.0" encoding="UTF-8"?>
<includes>
	<variable name="ArtworkStyle">
		<value condition="String.IsEqual(Skin.String(OSD.ArtworkStyle),DiscArt)">$LOCALIZE[427]</value>
		<value condition="String.IsEqual(Skin.String(OSD.ArtworkStyle),VHSArt)">VHS</value>
		<value>$LOCALIZE[351]</value>
	</variable>

	<variable name="Image_OSD_DiscArt">
		<value condition="!String.IsEmpty(Player.Art(discart))">$INFO[Player.Art(discart)]</value>
		<value condition="!String.IsEmpty(Player.Art(season.discart))">$INFO[Player.Art(season.discart)]</value>
		<value condition="!String.IsEmpty(Player.Art(tvshow.discart))">$INFO[Player.Art(tvshow.discart)]</value>
	</variable>

	<variable name="Image_OSD_VHSArt">
		<value condition="!String.IsEmpty(Player.Art(landscape))">$INFO[Player.Art(landscape)]</value>
		<value condition="!String.IsEmpty(Player.Art(season.landscape))">$INFO[Player.Art(season.landscape)]</value>
		<value condition="!String.IsEmpty(Player.Art(tvshow.landscape))">$INFO[Player.Art(tvshow.landscape)]</value>
		<value condition="VideoPlayer.Content(episodes) + !String.IsEmpty(Player.Art(thumb))">$INFO[Player.Art(thumb)]</value>
	</variable>

	<include name="PPI_Button">
		<!-- Button 9 -->
		<control type="button" id="6009">
			<include>Defs_OSD_Button</include>
			<onclick>CancelAlarm(osd_timeout,true)</onclick>
			<onclick>RunScript(script.tinyppi,dialog)</onclick>
			<visible>System.AddonIsEnabled(script.tinyppi)</visible>
		</control>
		<include content="OSD_Button_Icon_Overlay">
			<param name="icon">special://skin/extras/icons/ppi.png</param>
			<param name="visible">System.AddonIsEnabled(script.tinyppi)</param>
			<param name="id">6009</param>
			<param name="groupid">6109</param>
			<param name="itemgap">osd_itemgap</param>
		</include>
	</include>

	<include name="CD_VHS_Art">
		<!-- Disc -->
		<control type="group">
			<visible>[!Pvr.IsPlayingTv + [!String.IsEmpty(Player.Art(discart)) | !String.IsEmpty(Player.Art(season.discart)) | !String.IsEmpty(Player.Art(tvshow.discart))] + String.IsEqual(Skin.String(OSD.ArtworkStyle),DiscArt)]</visible>
			<right>-35</right>
			<top>400</top>
			<width>500</width>
			<height>425</height>
			<!-- Disc Background -->
			<control type="image">
				<width>500</width>
				<height>425</height>
				<texture colordiffuse="shadow_hard">u3k/discart.png</texture>
			</control>
			<!-- Disc Art -->
			<control type="image">
				<left>15</left>
				<top>10</top>
				<width>400</width>
				<height>400</height>
				<texture background="true">$VAR[Image_OSD_DiscArt]</texture>
				<aspectratio aligny="bottom">keep</aspectratio>
				<visible>Skin.HasSetting(OSD.DiscArtNoRotate)</visible>
			</control>
			<control type="image">
				<left>15</left>
				<top>10</top>
				<width>400</width>
				<height>400</height>
				<texture background="true">$VAR[Image_OSD_DiscArt]</texture>
				<aspectratio aligny="bottom">keep</aspectratio>
				<animation effect="rotate" start="0" end="-360" loop="true" time="20000" center="auto" condition="Player.Playing | Player.Paused">Conditional</animation>
				<visible>!Skin.HasSetting(OSD.DiscArtNoRotate)</visible>
			</control>
			<animation effect="slide" start="500" end="0" time="750">WindowOpen</animation>
			<animation effect="slide" start="0" end="500" time="750">WindowClose</animation>
			<animation effect="slide" start="0" end="500" time="750" condition="Control.HasFocus(6006) | Control.HasFocus(6007) | Control.HasFocus(6008)">
                    WindowClose
                </animation>
		</control>

		<!-- VHS -->
		<control type="group">
			<visible>[!Pvr.IsPlayingTv + [!String.IsEmpty(Player.Art(landscape)) | !String.IsEmpty(Player.Art(season.landscape)) | !String.IsEmpty(Player.Art(tvshow.landscape)) | [VideoPlayer.Content(episodes) + !String.IsEmpty(Player.Art(thumb))]] + String.IsEqual(Skin.String(OSD.ArtworkStyle),VHSArt)]</visible>
			<right>67</right>
			<top>510</top>
			<width>538</width>
			<height>300</height>
			<!-- VHS Background -->
			<control type="image">
				<right>23</right>
				<width>500</width>
				<height>280</height>
				<texture colordiffuse="shadow_hard">common/white.png</texture>
			</control>
			<control type="image">
				<width>538</width>
				<height>300</height>
				<texture>u3k/vhs.png</texture>
			</control>
			<control type="image">
				<left>150</left>
				<top>93</top>
				<width>239</width>
				<height>134</height>
				<texture background="true" diffuse="diffuse/landscape_w410_h231.png">$VAR[Image_OSD_VHSArt]</texture>
				<aspectratio>scale</aspectratio>
			</control>
			<animation type="WindowOpen">
				<effect type="rotate" start="-90" end="0" time="1000" center="auto" tween="linear" easing="in" />
				<effect type="slide" start="500" end="0" time="2000" tween="back" easing="out" />
			</animation>
			<animation type="WindowClose">
				<effect type="slide" start="0" end="500" time="500" />
			</animation>
			<animation condition="Control.HasFocus(6006) | Control.HasFocus(6007) | Control.HasFocus(6008)">
				<effect type="rotate" start="0" end="-90" time="1000" center="auto" tween="linear" easing="in" />
				<effect type="slide" start="0" end="700" time="2000" tween="back" easing="inout" />
                        WindowClose
			</animation>
		</control>
	</include>
</includes>

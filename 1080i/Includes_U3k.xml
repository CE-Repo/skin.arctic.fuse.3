<?xml version="1.0" encoding="UTF-8"?>
<includes>
	<include name="Info_Line_Height_U3k">
		<height>50</height>
	</include>

	<variable name="ArtworkStyle">
		<value condition="String.IsEqual(Skin.String(OSD.ArtworkStyle),DiscArt)">$LOCALIZE[427]</value>
		<value condition="String.IsEqual(Skin.String(OSD.ArtworkStyle),VHSArt)">VHS</value>
		<value>$LOCALIZE[351]</value>
	</variable>

	<variable name="Image_OSD_DiscArt">
		<value condition="!String.IsEmpty(Player.Art(discart))">$INFO[Player.Art(discart)]</value>
		<value condition="!String.IsEmpty(Player.Art(season.discart))">$INFO[Player.Art(season.discart)]</value>
		<value condition="!String.IsEmpty(Player.Art(tvshow.discart))">$INFO[Player.Art(tvshow.discart)]</value>
	</variable>

	<variable name="Image_OSD_VHSArt">
		<value condition="!String.IsEmpty(Player.Art(landscape))">$INFO[Player.Art(landscape)]</value>
		<value condition="!String.IsEmpty(Player.Art(season.landscape))">$INFO[Player.Art(season.landscape)]</value>
		<value condition="!String.IsEmpty(Player.Art(tvshow.landscape))">$INFO[Player.Art(tvshow.landscape)]</value>
		<value condition="VideoPlayer.Content(episodes) + !String.IsEmpty(Player.Art(thumb))">$INFO[Player.Art(thumb)]</value>
	</variable>

	<include name="PPI_Button">
		<!-- Button 9 -->
		<control type="button" id="6009">
			<include>Defs_OSD_Button</include>
			<onclick>CancelAlarm(osd_timeout,true)</onclick>
			<onclick>RunScript(script.tinyppi,dialog)</onclick>
			<visible>System.AddonIsEnabled(script.tinyppi)</visible>
		</control>
		<include content="OSD_Button_Icon_Overlay">
			<param name="icon">special://skin/extras/icons/ppi.png</param>
			<param name="visible">System.AddonIsEnabled(script.tinyppi)</param>
			<param name="id">6009</param>
			<param name="groupid">6109</param>
			<param name="itemgap">osd_itemgap</param>
		</include>
	</include>

	<include name="CD_VHS_Art">
		<!-- Disc -->
		<control type="group">
			<visible>[!Pvr.IsPlayingTv + [!String.IsEmpty(Player.Art(discart)) | !String.IsEmpty(Player.Art(season.discart)) | !String.IsEmpty(Player.Art(tvshow.discart))] + String.IsEqual(Skin.String(OSD.ArtworkStyle),DiscArt)]</visible>
			<right>-35</right>
			<top>400</top>
			<width>500</width>
			<height>425</height>
			<!-- Disc Background -->
			<control type="image">
				<width>500</width>
				<height>425</height>
				<texture colordiffuse="shadow_hard">u3k/discart.png</texture>
			</control>
			<!-- Disc Art -->
			<control type="image">
				<left>15</left>
				<top>10</top>
				<width>400</width>
				<height>400</height>
				<texture background="true">$VAR[Image_OSD_DiscArt]</texture>
				<aspectratio aligny="bottom">keep</aspectratio>
				<visible>Skin.HasSetting(OSD.DiscArtNoRotate)</visible>
			</control>
			<control type="image">
				<left>15</left>
				<top>10</top>
				<width>400</width>
				<height>400</height>
				<texture background="true">$VAR[Image_OSD_DiscArt]</texture>
				<aspectratio aligny="bottom">keep</aspectratio>
				<animation effect="rotate" start="0" end="-360" loop="true" time="20000" center="auto" condition="Player.Playing | Player.Paused">Conditional</animation>
				<visible>!Skin.HasSetting(OSD.DiscArtNoRotate)</visible>
			</control>
			<animation effect="slide" start="500" end="0" time="750">WindowOpen</animation>
			<animation effect="slide" start="0" end="500" time="750">WindowClose</animation>
			<animation effect="slide" start="0" end="500" time="750" condition="Control.HasFocus(6006) | Control.HasFocus(6007) | Control.HasFocus(6008)">
                    WindowClose
                </animation>
		</control>

		<!-- VHS -->
		<control type="group">
			<visible>[!Pvr.IsPlayingTv + [!String.IsEmpty(Player.Art(landscape)) | !String.IsEmpty(Player.Art(season.landscape)) | !String.IsEmpty(Player.Art(tvshow.landscape)) | [VideoPlayer.Content(episodes) + !String.IsEmpty(Player.Art(thumb))]] + String.IsEqual(Skin.String(OSD.ArtworkStyle),VHSArt)]</visible>
			<right>67</right>
			<top>510</top>
			<width>538</width>
			<height>300</height>
			<!-- VHS Background -->
			<control type="image">
				<right>23</right>
				<width>500</width>
				<height>280</height>
				<texture colordiffuse="shadow_hard">common/white.png</texture>
			</control>
			<control type="image">
				<width>538</width>
				<height>300</height>
				<texture>u3k/vhs.png</texture>
			</control>
			<control type="image">
				<left>150</left>
				<top>93</top>
				<width>239</width>
				<height>134</height>
				<texture background="true" diffuse="diffuse/landscape_w410_h231.png">$VAR[Image_OSD_VHSArt]</texture>
				<aspectratio>scale</aspectratio>
			</control>
			<animation type="WindowOpen">
				<effect type="rotate" start="-90" end="0" time="1000" center="auto" tween="linear" easing="in" />
				<effect type="slide" start="500" end="0" time="2000" tween="back" easing="out" />
			</animation>
			<animation type="WindowClose">
				<effect type="slide" start="0" end="500" time="500" />
			</animation>
			<animation condition="Control.HasFocus(6006) | Control.HasFocus(6007) | Control.HasFocus(6008)">
				<effect type="rotate" start="0" end="-90" time="1000" center="auto" tween="linear" easing="in" />
				<effect type="slide" start="0" end="700" time="2000" tween="back" easing="inout" />
                        WindowClose
			</animation>
		</control>
	</include>

	<include name="DialogCustom_U3k_Items">
		<include content="Settings_Label">
			<param name="id">8005</param>
			<param name="dialog">true</param>
			<label>$LOCALIZE[31434]</label>
		</include>
		<include content="Settings_Button" description="Artwork Style">
			<param name="dialog">true</param>
			<param name="id">8006</param>
			<param name="control">button</param>
			<label>$LOCALIZE[39123] $LOCALIZE[736]</label>
			<label2>$VAR[ArtworkStyle]</label2>
			<onclick condition="String.IsEmpty(Skin.String(OSD.ArtworkStyle)) | String.IsEqual(Skin.String(OSD.ArtworkStyle),Off)">Skin.SetString(OSD.ArtworkStyle,DiscArt)</onclick>
			<onclick condition="String.IsEqual(Skin.String(OSD.ArtworkStyle),DiscArt)">Skin.SetString(OSD.ArtworkStyle,VHSArt)</onclick>
			<onclick condition="String.IsEqual(Skin.String(OSD.ArtworkStyle),VHSArt)">Skin.SetString(OSD.ArtworkStyle,Off)</onclick>
		</include>
		<include content="Settings_Button">
			<param name="dialog">true</param>
			<param name="id">8007</param>
			<param name="control">radiobutton</param>
			<label>$LOCALIZE[35227]</label>
			<selected>!Skin.HasSetting(OSD.DiscArtNoRotate)</selected>
			<onclick>Skin.ToggleSetting(OSD.DiscArtNoRotate)</onclick>
			<visible>String.IsEqual(Skin.String(OSD.ArtworkStyle),DiscArt)</visible>
		</include>
	</include>

    <!--
        ==== U3k Info Line ====
        Includes_U3k.xml is loaded first in Includes.xml and Kodi keeps the FIRST
        definition of an include name. So "Info_Line" below replaces the upstream
        wrapper from Includes_Info.xml without touching upstream files.
        Same interface as upstream: container / listitem / left / visible / colordiffuse / player.
        Upstream InfoLine_Content stays untouched (used by the Info line picker preview).
        Run tools/u3k_check.py after merging upstream updates.
    -->
    <include name="Info_Line"> <!-- U3K OVERRIDE -->
        <param name="left">40</param>
        <param name="visible">true</param>
        <param name="listitem">ListItem</param>
        <param name="player">false</param>
        <definition>
            <include content="Info_Line_Content_U3k">
                <param name="left">$PARAM[left]</param>
                <param name="visible">$PARAM[visible]</param>
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="player">$PARAM[player]</param>
                <param name="source">$PARAM[container]$PARAM[listitem].</param>
                <param name="dbtype">$PARAM[container]$PARAM[listitem].DBType</param>
                <param name="stereo">$PARAM[container]$PARAM[listitem].IsStereoscopic + !String.IsEqual($PARAM[container]$PARAM[listitem].StereoscopicMode,mono)</param>
                <param name="hours">$PARAM[container]$PARAM[listitem].Duration(h)</param>
                <param name="minutes">$PARAM[container]$PARAM[listitem].Duration(m)</param>
            </include>
        </definition>
    </include>

    <include name="Info_Line_Content_U3k">
        <definition>
            <control type="group">
                <visible>$PARAM[visible]</visible>
                <visible>[$PARAM[player] + !VideoPlayer.Content(livetv)] | [!$PARAM[player] + [String.IsEqual($PARAM[dbtype],movie) | String.IsEqual($PARAM[dbtype],tvshow) | String.IsEqual($PARAM[dbtype],season) | String.IsEqual($PARAM[dbtype],set) | String.IsEqual($PARAM[dbtype],episode) | String.IsEqual($PARAM[dbtype],video)]]</visible>
                <left>$PARAM[left]</left>
                <height>105</height>
                <control type="grouplist">
                    <hitrect x="0" y="0" w="0" h="0" />
                    <orientation>horizontal</orientation>
                    <itemgap>10</itemgap>
                    <left>-20</left>
                    <centertop>35</centertop>
                    <control type="group" description="Avoid grouplist chop with spacer">
                        <left>-10</left>
                        <width>20</width>
                    </control>
                    <include content="Info_Line_Media_U3k">
                        <param name="colordiffuse">$PARAM[colordiffuse]</param>
                        <param name="source">$PARAM[source]</param>
                        <param name="end">$PARAM[end]</param>
                        <param name="dbtype">$PARAM[dbtype]</param>
                        <param name="player">$PARAM[player]</param>
                        <param name="hours">$PARAM[hours]</param>
                        <param name="minutes">$PARAM[minutes]</param>
                        <param name="stereo">$PARAM[stereo]</param>
                        <param name="resolution">Info_Line_VideoQuality_Resolution_U3k</param>
                        <param name="hdr">Info_Line_VideoQuality_HDRType_U3k</param>
                    </include>
                </control>
                <control type="grouplist">
                    <hitrect x="0" y="0" w="0" h="0" />
                    <orientation>horizontal</orientation>
                    <itemgap>10</itemgap>
                    <left>-20</left>
                    <centertop>75</centertop>
                    <control type="group" description="Avoid grouplist chop with spacer">
                        <left>-10</left>
                        <width>20</width>
                    </control>
                    <include content="Info_Line_Details_U3k">
                        <param name="colordiffuse">$PARAM[colordiffuse]</param>
                        <param name="source">$PARAM[source]</param>
                        <param name="end">$PARAM[end]</param>
                        <param name="dbtype">$PARAM[dbtype]</param>
                        <param name="player">$PARAM[player]</param>
                        <param name="hours">$PARAM[hours]</param>
                        <param name="minutes">$PARAM[minutes]</param>
                        <param name="stereo">$PARAM[stereo]</param>
                    </include>
                </control>
            </control>
        </definition>
    </include>

    <!-- Video / audio pills (first row of the info line). resolution + hdr: include names for the labels -->
    <include name="Info_Line_Media_U3k">
        <definition>
            <include content="$PARAM[resolution]">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="playable">[[!$PARAM[player] + [String.IsEqual($PARAM[dbtype],movie) | String.IsEqual($PARAM[dbtype],episode) | String.IsEqual($PARAM[dbtype],video)]] | [$PARAM[player] + !VideoPlayer.Content(livetv)]]</param>
                <param name="is_8k">[Integer.IsGreater($PARAM[source]VideoResolution$PARAM[end],2160) | String.IsEqual($PARAM[source]VideoResolution$PARAM[end],8K)]</param>
                <param name="is_4k">[Integer.IsGreater($PARAM[source]VideoResolution$PARAM[end],1080) | String.IsEqual($PARAM[source]VideoResolution$PARAM[end],4K)]</param>
                <param name="is_fd">[Integer.IsGreater($PARAM[source]VideoResolution$PARAM[end],720)]</param>
                <param name="is_hd">[Integer.IsEqual($PARAM[source]VideoResolution$PARAM[end],720)]</param>
                <param name="is_sd">[!String.IsEmpty($PARAM[source]VideoResolution$PARAM[end])]</param>
            </include>
            <include content="Info_Line_Media_Items_U3k">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="source">$PARAM[source]</param>
                <param name="end">$PARAM[end]</param>
                <param name="stereo">$PARAM[stereo]</param>
                <param name="hdr">$PARAM[hdr]</param>
                <param name="playable">[[!$PARAM[player] + [String.IsEqual($PARAM[dbtype],movie) | String.IsEqual($PARAM[dbtype],episode) | String.IsEqual($PARAM[dbtype],video)]] | [$PARAM[player] + !VideoPlayer.Content(livetv)]]</param>
            </include>
        </definition>
    </include>

    <include name="Info_Line_Media_Items_U3k">
        <definition>
            <include content="Info_Line_Pill_Text" condition="Skin.HasSetting(InfoTags.EnableVideoAspect)">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="label">$INFO[$PARAM[source]VideoAspect$PARAM[end],,:1]</param>
                <param name="visible">$PARAM[playable] + !String.IsEmpty($PARAM[source]VideoAspect$PARAM[end])</param>
            </include>
            <include content="Info_Line_Pill_Text" condition="Skin.HasSetting(InfoTags.EnableVideoCodec)">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="label">[UPPERCASE]$INFO[$PARAM[source]VideoCodec$PARAM[end]][/UPPERCASE]</param>
                <param name="visible">$PARAM[playable] + !String.IsEmpty($PARAM[source]VideoCodec$PARAM[end])</param>
            </include>
            <include content="$PARAM[hdr]" condition="Skin.HasSetting(InfoTags.EnableHDR)">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="source">$PARAM[source]</param>
                <param name="end">$PARAM[end]</param>
                <param name="visible">$PARAM[playable]</param>
            </include>
            <include content="Info_Line_AudioCodec_U3k" condition="Skin.HasSetting(InfoTags.EnableAudioCodec)">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="source">$PARAM[source]</param>
                <param name="end">$PARAM[end]</param>
                <param name="visible">$PARAM[playable]</param>
            </include>
            <include content="Info_Line_AudioChannels_Resolution" condition="Skin.HasSetting(InfoTags.EnableAudioChannels)">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="source">$PARAM[source]</param>
                <param name="end">$PARAM[end]</param>
                <param name="visible">$PARAM[playable]</param>
            </include>
            <include content="Info_Line_Pill_Text" condition="Skin.HasSetting(InfoTags.Enable3D)">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="label">3D</param>
                <param name="visible">$PARAM[playable] + [$PARAM[stereo]]</param>
            </include>
        </definition>
    </include>

    <!-- Stars + labels/tags. Labels and tags come from upstream, so the Info line picker settings still apply -->
    <include name="Info_Line_Details_U3k">
        <param name="outline">Skin.HasSetting(InfoTags.EnablePills)</param>
        <definition>
            <include content="InfoLine_Stars_Outline_U3k" condition="$PARAM[outline]">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="source">$PARAM[source]</param>
                <param name="end">$PARAM[end]</param>
                <param name="visible">[[[[!$PARAM[player] + String.IsEqual($PARAM[dbtype],movie)] | [$PARAM[player] + VideoPlayer.Content(movies)]] + !Skin.HasSetting(InfoLine.movie.DisableStars)] | [!$PARAM[player] + String.IsEqual($PARAM[dbtype],tvshow) + !Skin.HasSetting(InfoLine.tvshow.DisableStars)] | [!$PARAM[player] + String.IsEqual($PARAM[dbtype],season) + !Skin.HasSetting(InfoLine.season.DisableStars)] | [!$PARAM[player] + String.IsEqual($PARAM[dbtype],set) + !Skin.HasSetting(InfoLine.set.DisableStars)] | [[[!$PARAM[player] + String.IsEqual($PARAM[dbtype],episode)] | [$PARAM[player] + VideoPlayer.Content(episodes)]] + !Skin.HasSetting(InfoLine.episode.DisableStars)] | [[[!$PARAM[player] + String.IsEqual($PARAM[dbtype],video)] | [$PARAM[player] + !VideoPlayer.Content(movies) + !VideoPlayer.Content(episodes) + !VideoPlayer.Content(livetv)]] + !Skin.HasSetting(InfoLine.video.DisableStars)]]</param>
            </include>
            <include content="InfoLine_Stars" condition="!$PARAM[outline]">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="source">$PARAM[source]</param>
                <param name="end">$PARAM[end]</param>
                <param name="visible">[[[[!$PARAM[player] + String.IsEqual($PARAM[dbtype],movie)] | [$PARAM[player] + VideoPlayer.Content(movies)]] + !Skin.HasSetting(InfoLine.movie.DisableStars)] | [!$PARAM[player] + String.IsEqual($PARAM[dbtype],tvshow) + !Skin.HasSetting(InfoLine.tvshow.DisableStars)] | [!$PARAM[player] + String.IsEqual($PARAM[dbtype],season) + !Skin.HasSetting(InfoLine.season.DisableStars)] | [!$PARAM[player] + String.IsEqual($PARAM[dbtype],set) + !Skin.HasSetting(InfoLine.set.DisableStars)] | [[[!$PARAM[player] + String.IsEqual($PARAM[dbtype],episode)] | [$PARAM[player] + VideoPlayer.Content(episodes)]] + !Skin.HasSetting(InfoLine.episode.DisableStars)] | [[[!$PARAM[player] + String.IsEqual($PARAM[dbtype],video)] | [$PARAM[player] + !VideoPlayer.Content(movies) + !VideoPlayer.Content(episodes) + !VideoPlayer.Content(livetv)]] + !Skin.HasSetting(InfoLine.video.DisableStars)]]</param>
            </include>
            <include content="Info_Line_Labels" condition="!Skin.HasSetting(InfoTags.EnablePills)">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="source">$PARAM[source]</param>
                <param name="end">$PARAM[end]</param>
                <param name="dbtype">$PARAM[dbtype]</param>
                <param name="player">$PARAM[player]</param>
                <param name="hours">$PARAM[hours]</param>
                <param name="minutes">$PARAM[minutes]</param>
                <param name="item">Info_Line_Label</param>
            </include>
            <include content="Info_Line_Tags" condition="Skin.HasSetting(InfoTags.EnablePills)">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="source">$PARAM[source]</param>
                <param name="end">$PARAM[end]</param>
                <param name="dbtype">$PARAM[dbtype]</param>
                <param name="player">$PARAM[player]</param>
                <param name="hours">$PARAM[hours]</param>
                <param name="minutes">$PARAM[minutes]</param>
            </include>
        </definition>
    </include>

    <!-- Star rating drawn like the outlined info line tags (date, MPAA, duration): the _lines font draws the tag outline
         around six em spaces (about the width of the filled star pill) and the stars sit on top. Used by the two row info line with pills -->
    <include name="InfoLine_Stars_Outline_U3k">
        <definition>
            <include content="Info_Line_StarRating_Outline_U3k">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="rating">$PARAM[source]Rating$PARAM[end]</param>
                <param name="visible">$PARAM[visible] + !String.IsEmpty($PARAM[source]Rating$PARAM[end]) + String.IsEmpty($PARAM[source]UserRating$PARAM[end])</param>
            </include>
            <include content="Info_Line_StarRating_Outline_U3k">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="rating">$PARAM[source]UserRating$PARAM[end]</param>
                <param name="visible">$PARAM[visible] + !String.IsEmpty($PARAM[source]UserRating$PARAM[end])</param>
            </include>
        </definition>
    </include>

    <include name="Info_Line_StarRating_Outline_U3k">
        <param name="font">font_tiny_bold_lines</param>
        <definition>
            <control type="group">
                <width>150</width>
                <visible>$PARAM[visible]</visible>
                <!-- Fixed width wider than the tag (about 148): a label narrower than its text scrolls or is cut -->
                <control type="label">
                    <label>&#x2002;&#x2003;&#x2003;&#x2003;&#x2003;&#x2003;&#x2003;&#x2000;</label>
                    <textcolor>$PARAM[colordiffuse]_90</textcolor>
                    <width>220</width>
                    <align>left</align>
                    <scroll>false</scroll>
                    <aligny>center</aligny>
                    <font>$PARAM[font]</font>
                </control>
                <include content="Info_StarRating">
                    <param name="colordiffuse">$PARAM[colordiffuse]_90</param>
                    <param name="rating">$PARAM[rating]</param>
                    <param name="size">40</param>
                    <height>40</height>
                    <width>136</width>
                    <left>6</left>
                    <centertop>50%</centertop>
                    <itemgap>-16</itemgap>
                </include>
            </control>
        </definition>
    </include>

    <include name="Info_Line_VideoQuality_Resolution_U3k">
        <param name="visible">true</param>
        <param name="playable">true</param>
        <definition>
            <include content="Info_Line_Pill_Text">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="label">8K</param>
                <param name="visible">$PARAM[visible] + $PARAM[playable] + $PARAM[is_8k]</param>
                <param name="width">60</param>
            </include>
            <include content="Info_Line_Pill_Text">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="label">4K Ultra HD</param>
                <param name="visible">$PARAM[visible] + $PARAM[playable] + !$PARAM[is_8k] + $PARAM[is_4k]</param>
                <param name="width">auto</param>
            </include>
            <include content="Info_Line_Pill_Text">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="label">Full HD</param>
                <param name="visible">$PARAM[visible] + $PARAM[playable] + !$PARAM[is_8k] + !$PARAM[is_4k] + $PARAM[is_fd]</param>
                <param name="width">auto</param>
            </include>
            <include content="Info_Line_Pill_Text">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="label">HD</param>
                <param name="visible">$PARAM[visible] + $PARAM[playable] + !$PARAM[is_8k] + !$PARAM[is_4k] + !$PARAM[is_fd] + $PARAM[is_hd]</param>
                <param name="width">60</param>
            </include>
            <include content="Info_Line_Pill_Text">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="label">SD</param>
                <param name="visible">$PARAM[visible] + $PARAM[playable] + !$PARAM[is_8k] + !$PARAM[is_4k] + !$PARAM[is_fd] + !$PARAM[is_hd] + $PARAM[is_sd]</param>
                <param name="width">60</param>
            </include>
            <include content="Info_Line_Pill_Icon">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="icon">flags/info-inverted.png</param>
                <param name="visible">$PARAM[visible] + [!$PARAM[playable] | [!$PARAM[is_8k] + !$PARAM[is_4k] + !$PARAM[is_fd] + !$PARAM[is_hd] + !$PARAM[is_sd]]]</param>
                <param name="width">60</param>
            </include>
        </definition>
    </include>

    <include name="Info_Line_VideoQuality_HDRType_U3k">
        <param name="visible">true</param>
        <definition>
            <include content="Info_Line_Pill_Text">

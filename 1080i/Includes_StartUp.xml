<?xml version='1.0' encoding='UTF-8'?>
<includes>
    <!-- Local 24-hour ranges shared by the startup layer selectors. -->
    <expression name="Exp_StartUp_Time_BeforeDawn">System.Time(00:00,05:00)</expression>
    <expression name="Exp_StartUp_Time_DawnToDusk">System.Time(06:00,18:00)</expression>
    <expression name="Exp_StartUp_Time_Daytime">System.Time(08:00,17:00)</expression>
    <expression name="Exp_StartUp_Time_0500_0600">System.Time(05:00,06:00)</expression>
    <expression name="Exp_StartUp_Time_0600_0700">System.Time(06:00,07:00)</expression>
    <expression name="Exp_StartUp_Time_0700_0800">System.Time(07:00,08:00)</expression>
    <expression name="Exp_StartUp_Time_1700_1800">System.Time(17:00,18:00)</expression>
    <expression name="Exp_StartUp_Time_1800_1900">System.Time(18:00,19:00)</expression>
    <expression name="Exp_StartUp_Time_1900_2000">System.Time(19:00,20:00)</expression>
    <!-- Registered 1920x1080 image layers with separate animated weather overlays. -->
    <!-- Kodi weather codes: https://kodi.wiki/view/Weather_addons#Weather_Codes -->
    <expression name="Exp_StartUp_CustomImage">!String.IsEmpty(Skin.String(Startup.ImageFolder)) + !Skin.String(Startup.ImageFolder,special://skin/extras/backgrounds/launch/)</expression>
    <expression name="Exp_StartUp_Weather_Thunderstorm">String.IsEqual(Weather.FanartCode,0) | String.IsEqual(Weather.FanartCode,00) | String.IsEqual(Weather.FanartCode,1) | String.IsEqual(Weather.FanartCode,01) | String.IsEqual(Weather.FanartCode,2) | String.IsEqual(Weather.FanartCode,02) | String.IsEqual(Weather.FanartCode,3) | String.IsEqual(Weather.FanartCode,03) | String.IsEqual(Weather.FanartCode,4) | String.IsEqual(Weather.FanartCode,04) | String.IsEqual(Weather.FanartCode,37) | String.IsEqual(Weather.FanartCode,38) | String.IsEqual(Weather.FanartCode,39) | String.IsEqual(Weather.FanartCode,45) | String.IsEqual(Weather.FanartCode,47)</expression>
    <expression name="Exp_StartUp_Weather_Hazy">String.IsEqual(Weather.FanartCode,19) | String.IsEqual(Weather.FanartCode,20) | String.IsEqual(Weather.FanartCode,21) | String.IsEqual(Weather.FanartCode,22)</expression>
    <expression name="Exp_StartUp_Weather_Rain">String.IsEqual(Weather.FanartCode,6) | String.IsEqual(Weather.FanartCode,06) | String.IsEqual(Weather.FanartCode,8) | String.IsEqual(Weather.FanartCode,08) | String.IsEqual(Weather.FanartCode,9) | String.IsEqual(Weather.FanartCode,09) | String.IsEqual(Weather.FanartCode,10) | String.IsEqual(Weather.FanartCode,11) | String.IsEqual(Weather.FanartCode,12) | String.IsEqual(Weather.FanartCode,17) | String.IsEqual(Weather.FanartCode,18) | String.IsEqual(Weather.FanartCode,35) | String.IsEqual(Weather.FanartCode,40)</expression>
    <expression name="Exp_StartUp_Weather_Cloud">String.IsEqual(Weather.FanartCode,23) | String.IsEqual(Weather.FanartCode,26) | String.IsEqual(Weather.FanartCode,27) | String.IsEqual(Weather.FanartCode,28) | String.IsEqual(Weather.FanartCode,29) | String.IsEqual(Weather.FanartCode,30) | String.IsEqual(Weather.FanartCode,44)</expression>
    <expression name="Exp_StartUp_Weather_Snow">String.IsEqual(Weather.FanartCode,5) | String.IsEqual(Weather.FanartCode,05) | String.IsEqual(Weather.FanartCode,7) | String.IsEqual(Weather.FanartCode,07) | String.IsEqual(Weather.FanartCode,13) | String.IsEqual(Weather.FanartCode,14) | String.IsEqual(Weather.FanartCode,15) | String.IsEqual(Weather.FanartCode,16) | String.IsEqual(Weather.FanartCode,41) | String.IsEqual(Weather.FanartCode,42) | String.IsEqual(Weather.FanartCode,43) | String.IsEqual(Weather.FanartCode,46)</expression>
    <!-- Exact string matches keep missing, na and malformed codes out of numeric code 0 (tornado). -->
    <expression name="Exp_StartUp_Weather_Clear">![$EXP[Exp_StartUp_Weather_Thunderstorm] | $EXP[Exp_StartUp_Weather_Hazy] | $EXP[Exp_StartUp_Weather_Rain] | $EXP[Exp_StartUp_Weather_Snow] | $EXP[Exp_StartUp_Weather_Cloud]]</expression>
    <variable name="Image_StartUp_Weather">
        <value condition="$EXP[Exp_StartUp_Weather_Thunderstorm]">thunderstorm</value>
        <value condition="$EXP[Exp_StartUp_Weather_Hazy]">hazy</value>
        <value condition="$EXP[Exp_StartUp_Weather_Rain]">rain</value>
        <value condition="$EXP[Exp_StartUp_Weather_Snow]">snow</value>
        <value condition="$EXP[Exp_StartUp_Weather_Cloud]">cloud</value>
        <value>clear</value>
    </variable>
    <!-- Snow reuses overcast rain plates; storm bolts appear only during flashes. -->
    <variable name="Image_StartUp_Layer_BaseWeather">
        <value condition="$EXP[Exp_StartUp_Weather_Thunderstorm] | $EXP[Exp_StartUp_Weather_Snow]">rain</value>
        <value>$VAR[Image_StartUp_Weather]</value>
    </variable>
    <!-- Hour aliases reuse identical plates through the shared local-time ranges. -->
    <variable name="Image_StartUp_Layer_Sky">
        <value condition="$EXP[Exp_StartUp_Time_0500_0600] | $EXP[Exp_StartUp_Time_1900_2000]">special://home/addons/resource.images.arctic.splash/resources/layers/01-sky/0500.jpg</value>
        <value condition="$EXP[Exp_StartUp_Time_0600_0700] | $EXP[Exp_StartUp_Time_1800_1900]">special://home/addons/resource.images.arctic.splash/resources/layers/01-sky/0600.jpg</value>
        <value condition="$EXP[Exp_StartUp_Time_0700_0800] | $EXP[Exp_StartUp_Time_1700_1800]">special://home/addons/resource.images.arctic.splash/resources/layers/01-sky/0700.jpg</value>
        <value condition="$EXP[Exp_StartUp_Time_Daytime]">special://home/addons/resource.images.arctic.splash/resources/layers/01-sky/0800.jpg</value>
        <value>special://home/addons/resource.images.arctic.splash/resources/layers/01-sky/0000.jpg</value>
    </variable>
    <variable name="Image_StartUp_Layer_CloudHour">
        <value condition="$EXP[Exp_StartUp_Time_0500_0600]">0500</value>
        <value condition="$EXP[Exp_StartUp_Time_0600_0700]">0600</value>
        <value condition="$EXP[Exp_StartUp_Time_0700_0800]">0700</value>
        <value condition="$EXP[Exp_StartUp_Time_Daytime]">0800</value>
        <value condition="$EXP[Exp_StartUp_Time_1700_1800]">1700</value>
        <value condition="$EXP[Exp_StartUp_Time_1800_1900]">1800</value>
        <value condition="$EXP[Exp_StartUp_Time_1900_2000]">1900</value>
        <value>0000</value>
    </variable>
    <variable name="Image_StartUp_Layer_GlowHour">
        <value condition="$EXP[Exp_StartUp_Time_0500_0600] | $EXP[Exp_StartUp_Time_0700_0800]">0500</value>
        <value condition="$EXP[Exp_StartUp_Time_0600_0700]">0600</value>
        <value condition="$EXP[Exp_StartUp_Time_1700_1800] | $EXP[Exp_StartUp_Time_1900_2000]">1700</value>
        <value condition="$EXP[Exp_StartUp_Time_1800_1900]">1800</value>
        <value>0000</value>
    </variable>
    <variable name="Image_StartUp_Layer_ConditionsHour">
        <value condition="$EXP[Exp_StartUp_Weather_Clear]">0000</value>
        <value condition="$EXP[Exp_StartUp_Time_0500_0600] | $EXP[Exp_StartUp_Time_1900_2000]">0500</value>
        <value condition="$EXP[Exp_StartUp_Time_0600_0700] | $EXP[Exp_StartUp_Time_1800_1900]">0600</value>
        <value condition="$EXP[Exp_StartUp_Time_0700_0800] | $EXP[Exp_StartUp_Time_1700_1800]">0700</value>
        <value condition="$EXP[Exp_StartUp_Time_Daytime]">0800</value>
        <value>0000</value>
    </variable>
    <variable name="Image_StartUp_Layer_TimeHour">
        <value condition="$EXP[Exp_StartUp_Time_BeforeDawn]">0000</value>
        <value condition="$EXP[Exp_StartUp_Time_0500_0600]">0500</value>
        <value condition="$EXP[Exp_StartUp_Time_0600_0700]">0600</value>
        <value condition="$EXP[Exp_StartUp_Time_0700_0800]">0700</value>
        <value condition="$EXP[Exp_StartUp_Time_Daytime]">0800</value>
        <value condition="$EXP[Exp_StartUp_Time_1700_1800]">1700</value>
        <value condition="$EXP[Exp_StartUp_Time_1800_1900]">1800</value>
        <value condition="$EXP[Exp_StartUp_Time_1900_2000]">1900</value>
        <value>2000</value>
    </variable>
    <variable name="Image_StartUp_Layer_Time">
        <value condition="$EXP[Exp_StartUp_Time_Daytime]">special://home/addons/resource.images.arctic.splash/resources/layers/09-time/autumn/0800.webp</value>
        <value>special://home/addons/resource.images.arctic.splash/resources/layers/09-time/$VAR[Image_StartUp_Season]/$VAR[Image_StartUp_Layer_TimeHour].webp</value>
    </variable>
    <include name="Background_StartUp_Layered">
        <!-- Pass all hour aliases together when overriding hour; the resource shares identical plates. -->
        <!-- The time texture also contains season; override it when selecting a different season. -->
        <param name="season">$VAR[Image_StartUp_Season]</param>
        <param name="weather">$VAR[Image_StartUp_Weather]</param>
        <param name="base_weather">$VAR[Image_StartUp_Layer_BaseWeather]</param>
        <param name="rain_visible">$EXP[Exp_StartUp_Weather_Rain] | $EXP[Exp_StartUp_Weather_Thunderstorm]</param>
        <param name="snow_visible">$EXP[Exp_StartUp_Weather_Snow]</param>
        <param name="lightning_visible">$EXP[Exp_StartUp_Weather_Thunderstorm]</param>
        <param name="cloud_visible">true</param>
        <param name="haze_visible">$EXP[Exp_StartUp_Weather_Hazy]</param>
        <param name="foliage_visible">true</param>
        <param name="dimming_visible">$EXP[Exp_StartUp_Time_DawnToDusk]</param>
        <param name="hour">$VAR[Image_StartUp_Hour]</param>
        <param name="sky">$VAR[Image_StartUp_Layer_Sky]</param>
        <param name="cloud_hour">$VAR[Image_StartUp_Layer_CloudHour]</param>
        <param name="glow_hour">$VAR[Image_StartUp_Layer_GlowHour]</param>
        <param name="conditions_hour">$VAR[Image_StartUp_Layer_ConditionsHour]</param>
        <param name="time">$VAR[Image_StartUp_Layer_Time]</param>
        <definition>
            <control type="group">
                <description>Seasonal hourly weather splash with animated clouds, rain, snow and lightning</description>
                <left>0</left>
                <top>0</top>
                <width>100%</width>
                <height>100%</height>
                <control type="image">
                    <description>Sky</description>
                    <aspectratio align="center" aligny="center">scale</aspectratio>
                    <texture colordiffuse="ffffffff">$PARAM[sky]</texture>
                </control>
                <control type="image">
                    <description>Sun/Moon</description>
                    <aspectratio align="center" aligny="center">scale</aspectratio>
                    <texture colordiffuse="ffffffff">special://home/addons/resource.images.arctic.splash/resources/layers/02-sun-moon/$PARAM[hour].png</texture>
                </control>
                <control type="image">
                    <description>Clouds</description>
                    <visible>![$PARAM[cloud_visible]]</visible>
                    <aspectratio align="center" aligny="center">scale</aspectratio>
                    <texture colordiffuse="ffffffff">special://home/addons/resource.images.arctic.splash/resources/layers/03-clouds/$PARAM[base_weather]/$PARAM[cloud_hour].webp</texture>
                </control>
                <include content="Background_StartUp_TextureDrift">
                    <param name="visible">$PARAM[cloud_visible]</param>
                    <param name="texture">special://home/addons/resource.images.arctic.splash/resources/layers/03-clouds/$PARAM[base_weather]/$PARAM[cloud_hour].webp</param>
                </include>
                <include content="Background_StartUp_Lightning">
                    <param name="visible">$PARAM[lightning_visible]</param>
                    <param name="texture">special://home/addons/resource.images.arctic.splash/resources/layers/03-clouds/thunderstorm/$PARAM[cloud_hour].webp</param>
                </include>
                <control type="image">
                    <description>Sunset/Sunrise</description>
                    <aspectratio align="center" aligny="center">scale</aspectratio>
                    <texture colordiffuse="ffffffff">special://home/addons/resource.images.arctic.splash/resources/layers/04-sunset-sunrise/$PARAM[glow_hour].png</texture>
                </control>
                <control type="image">
                    <description>Mountains</description>
                    <aspectratio align="center" aligny="center">scale</aspectratio>
                    <texture colordiffuse="ffffffff">special://home/addons/resource.images.arctic.splash/resources/layers/05-mountains/$PARAM[season].webp</texture>
                </control>
                <include content="Background_StartUp_Lake">
                    <param name="texture">special://home/addons/resource.images.arctic.splash/resources/layers/06-lake/$PARAM[season]/$PARAM[base_weather]/$PARAM[hour].webp</param>
                </include>
                <!-- Cloud reflections drift independently over the rippling lake. -->
                <include content="Background_StartUp_TextureDrift">
                    <param name="visible">$PARAM[cloud_visible]</param>
                    <param name="texture">special://home/addons/resource.images.arctic.splash/resources/layers/03-clouds/$PARAM[base_weather]/$PARAM[cloud_hour].webp</param>
                    <param name="top">706</param>
                    <param name="height">374</param>
                    <param name="flipy">true</param>
                    <param name="colordiffuse">26ffffff</param>
                </include>
                <include content="Background_StartUp_Lightning">
                    <param name="visible">$PARAM[lightning_visible]</param>
                    <param name="texture">special://home/addons/resource.images.arctic.splash/resources/layers/06-lake/$PARAM[season]/thunderstorm/$PARAM[hour].webp</param>
                </include>





                <control type="image">
                    <description>Trees</description>
                    <aspectratio align="center" aligny="center">scale</aspectratio>
                    <texture colordiffuse="ffffffff">special://home/addons/resource.images.arctic.splash/resources/layers/07-trees/$PARAM[season].webp</texture>
                </control>
                <control type="image">
                    <description>Conditions</description>
                    <visible>![$PARAM[rain_visible]] + ![$PARAM[snow_visible]] + ![$PARAM[haze_visible]]</visible>
                    <aspectratio align="center" aligny="center">scale</aspectratio>
                    <texture colordiffuse="ffffffff">special://home/addons/resource.images.arctic.splash/resources/layers/08-conditions/$PARAM[base_weather]/$PARAM[conditions_hour].png</texture>
                </control>

                <include content="Background_StartUp_TextureDrift">
                    <param name="visible">$PARAM[haze_visible]</param>
                    <param name="texture">special://home/addons/resource.images.arctic.splash/resources/layers/08-conditions/hazy/$PARAM[conditions_hour].png</param>
                    <param name="time">1200000</param>
                </include>
                <control type="image">
                    <description>Time</description>
                    <aspectratio align="center" aligny="center">scale</aspectratio>
                    <texture colordiffuse="ffffffff">$PARAM[time]</texture>
                </control>

                <control type="image">
                    <texture colordiffuse="55000000">common/white.png</texture>
                    <visible>$PARAM[dimming_visible]</visible>
                </control>

                <nested />

                <!-- Foliage carries the same hourly grade as the trees; the static time
                     plate only grades the registered scenery beneath these moving pieces. -->
                <include content="Background_StartUp_Foliage">
                    <param name="visible">[$PARAM[foliage_visible]] + ![$PARAM[rain_visible]] + ![$PARAM[snow_visible]]</param>
                    <param name="season">$PARAM[season]</param>
                    <param name="hour">$PARAM[cloud_hour]</param>
                </include>
                <include content="Background_StartUp_Lightning">
                    <param name="visible">$PARAM[lightning_visible]</param>
                    <param name="texture">common/white.png</param>
                    <param name="colordiffuse">33cadfff</param>
                    <param name="echo_colordiffuse">22cadfff</param>
                </include>
                <include content="Background_StartUp_Rain">
                    <param name="visible">$PARAM[rain_visible]</param>
                </include>
                <include content="Background_StartUp_Snow">
                    <param name="visible">$PARAM[snow_visible]</param>
                </include>

            </control>
        </definition>
    </include>
</includes>

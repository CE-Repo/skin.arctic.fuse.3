<?xml version="1.0" encoding="UTF-8"?>
<includes>

    <!--
        ==== U3k Info Line ====
        Two-row info line. Replaces upstream Info_Line (Includes_Info.xml), same params:
        container / listitem / left / visible / colordiffuse / player.
        Row 1 (centertop 35): resolution, aspect, video codec, HDR, audio codec/channels, 3D
        Row 2 (centertop 75): stars + upstream Info_Line_Labels / Info_Line_Tags
        Upstream InfoLine_Content stays untouched. The Info line picker preview (Dialog_InfoLine.xml) calls Info_Line, so it shows this U3k layout.
        Params follow upstream: source = container+listitem without trailing dot ($PARAM[source].X), no end/duration.
        Row 1 always uses U3k pills, row 2 follows Skin.String(InfoTags.Style): Pill = outlined tags, Text/Flag = labels.
        Related: Includes_Info.xml height 50, skinvariables-infoline-budget.json (no evictions).
        Includes_InfoLine.xml: Duration (mins) label uppercased (U3K OVERRIDE marker).
    -->
    <include name="Info_Line"> <!-- U3K OVERRIDE -->
        <param name="left">40</param>
        <param name="visible">true</param>
        <param name="listitem">ListItem</param>
        <param name="player">false</param>
        <definition>
            <include content="Info_Line_Content_U3k">
                <param name="left">$PARAM[left]</param>
                <param name="visible">$PARAM[visible]</param>
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="player">$PARAM[player]</param>
                <param name="source">$PARAM[container]$PARAM[listitem]</param>
                <param name="dbtype">$PARAM[container]$PARAM[listitem].DBType</param>
                <param name="stereo">$PARAM[container]$PARAM[listitem].IsStereoscopic + !String.IsEqual($PARAM[container]$PARAM[listitem].StereoscopicMode,mono)</param>
            </include>
        </definition>
    </include>

    <include name="Info_Line_Content_U3k">
        <definition>
            <control type="group">
                <visible>$PARAM[visible]</visible>
                <visible>[$PARAM[player] + !VideoPlayer.Content(livetv)] | [!$PARAM[player] + [String.IsEqual($PARAM[dbtype],movie) | String.IsEqual($PARAM[dbtype],tvshow) | String.IsEqual($PARAM[dbtype],season) | String.IsEqual($PARAM[dbtype],set) | String.IsEqual($PARAM[dbtype],episode) | String.IsEqual($PARAM[dbtype],video)]]</visible>
                <left>$PARAM[left]</left>
                <height>105</height>
                <control type="grouplist">
                    <hitrect x="0" y="0" w="0" h="0" />
                    <orientation>horizontal</orientation>
                    <itemgap>10</itemgap>
                    <left>-20</left>
                    <centertop>35</centertop>
                    <control type="group" description="Avoid grouplist chop with spacer">
                        <left>-10</left>
                        <width>20</width>
                    </control>
                    <include content="Info_Line_Media_U3k">
                        <param name="colordiffuse">$PARAM[colordiffuse]</param>
                        <param name="source">$PARAM[source]</param>
                        <param name="dbtype">$PARAM[dbtype]</param>
                        <param name="player">$PARAM[player]</param>
                        <param name="stereo">$PARAM[stereo]</param>
                        <param name="resolution">Info_Line_VideoQuality_Resolution_U3k</param>
                        <param name="hdr">Info_Line_VideoQuality_HDRType_U3k</param>
                    </include>
                </control>
                <control type="grouplist">
                    <hitrect x="0" y="0" w="0" h="0" />
                    <orientation>horizontal</orientation>
                    <itemgap>10</itemgap>
                    <left>-20</left>
                    <centertop>75</centertop>
                    <control type="group" description="Avoid grouplist chop with spacer">
                        <left>-10</left>
                        <width>20</width>
                    </control>
                    <include content="Info_Line_Details_U3k">
                        <param name="outline">Skin.String(InfoTags.Style,Pill)</param>
                        <param name="colordiffuse">$PARAM[colordiffuse]</param>
                        <param name="source">$PARAM[source]</param>
                        <param name="dbtype">$PARAM[dbtype]</param>
                        <param name="player">$PARAM[player]</param>
                        <param name="stereo">$PARAM[stereo]</param>
                    </include>
                </control>
            </control>
        </definition>
    </include>

    <include name="Info_Line_Media_U3k">
        <definition>
            <include content="$PARAM[resolution]">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="playable">[[!$PARAM[player] + [String.IsEqual($PARAM[dbtype],movie) | String.IsEqual($PARAM[dbtype],episode) | String.IsEqual($PARAM[dbtype],video)]] | [$PARAM[player] + !VideoPlayer.Content(livetv)]]</param>
                <param name="is_8k">[Integer.IsGreater($PARAM[source].VideoResolution,2160) | String.IsEqual($PARAM[source].VideoResolution,8K)]</param>
                <param name="is_4k">[Integer.IsGreater($PARAM[source].VideoResolution,1080) | String.IsEqual($PARAM[source].VideoResolution,4K)]</param>
                <param name="is_fd">[Integer.IsGreater($PARAM[source].VideoResolution,720)]</param>
                <param name="is_hd">[Integer.IsEqual($PARAM[source].VideoResolution,720)]</param>
                <param name="is_sd">[!String.IsEmpty($PARAM[source].VideoResolution)]</param>
            </include>
            <include content="Info_Line_Media_Items_U3k">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="source">$PARAM[source]</param>
                <param name="stereo">$PARAM[stereo]</param>
                <param name="hdr">$PARAM[hdr]</param>
                <param name="playable">[[!$PARAM[player] + [String.IsEqual($PARAM[dbtype],movie) | String.IsEqual($PARAM[dbtype],episode) | String.IsEqual($PARAM[dbtype],video)]] | [$PARAM[player] + !VideoPlayer.Content(livetv)]]</param>
            </include>
        </definition>
    </include>

    <include name="Info_Line_Media_Items_U3k">
        <definition>
            <include content="Info_Line_Pill_Text" condition="Skin.HasSetting(InfoTags.EnableVideoAspect)">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="label">$INFO[$PARAM[source].VideoAspect,,:1]</param>
                <param name="visible">$PARAM[playable] + !String.IsEmpty($PARAM[source].VideoAspect)</param>
            </include>
            <include content="Info_Line_Pill_Text" condition="Skin.HasSetting(InfoTags.EnableVideoCodec)">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="label">[UPPERCASE]$INFO[$PARAM[source].VideoCodec][/UPPERCASE]</param>
                <param name="visible">$PARAM[playable] + !String.IsEmpty($PARAM[source].VideoCodec)</param>
            </include>
            <include content="$PARAM[hdr]" condition="Skin.HasSetting(InfoTags.EnableHDR)">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="source">$PARAM[source]</param>
                <param name="visible">$PARAM[playable]</param>
            </include>
            <include content="Info_Line_AudioCodec_U3k" condition="Skin.HasSetting(InfoTags.EnableAudioCodec)">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="source">$PARAM[source]</param>
                <param name="visible">$PARAM[playable]</param>
            </include>
            <include content="Info_Line_AudioChannels_Resolution" condition="Skin.HasSetting(InfoTags.EnableAudioChannels)">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="source">$PARAM[source]</param>
                <param name="visible">$PARAM[playable]</param>
            </include>
            <include content="Info_Line_Pill_Text" condition="Skin.HasSetting(InfoTags.Enable3D)">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="label">3D</param>
                <param name="visible">$PARAM[playable] + [$PARAM[stereo]]</param>
            </include>
        </definition>
    </include>

    <include name="Info_Line_Details_U3k">
        <param name="outline">false</param>
        <definition>
            <include content="InfoLine_Stars_Outline_U3k" condition="$PARAM[outline]">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="source">$PARAM[source]</param>
                <param name="visible">[[[[!$PARAM[player] + String.IsEqual($PARAM[dbtype],movie)] | [$PARAM[player] + VideoPlayer.Content(movies)]] + !Skin.HasSetting(InfoLine.movie.DisableStars)] | [!$PARAM[player] + String.IsEqual($PARAM[dbtype],tvshow) + !Skin.HasSetting(InfoLine.tvshow.DisableStars)] | [!$PARAM[player] + String.IsEqual($PARAM[dbtype],season) + !Skin.HasSetting(InfoLine.season.DisableStars)] | [!$PARAM[player] + String.IsEqual($PARAM[dbtype],set) + !Skin.HasSetting(InfoLine.set.DisableStars)] | [[[!$PARAM[player] + String.IsEqual($PARAM[dbtype],episode)] | [$PARAM[player] + VideoPlayer.Content(episodes)]] + !Skin.HasSetting(InfoLine.episode.DisableStars)] | [[[!$PARAM[player] + String.IsEqual($PARAM[dbtype],video)] | [$PARAM[player] + !VideoPlayer.Content(movies) + !VideoPlayer.Content(episodes) + !VideoPlayer.Content(livetv)]] + !Skin.HasSetting(InfoLine.video.DisableStars)]]</param>
            </include>
            <include content="InfoLine_Stars" condition="!$PARAM[outline]">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="source">$PARAM[source]</param>
                <param name="visible">[[[[!$PARAM[player] + String.IsEqual($PARAM[dbtype],movie)] | [$PARAM[player] + VideoPlayer.Content(movies)]] + !Skin.HasSetting(InfoLine.movie.DisableStars)] | [!$PARAM[player] + String.IsEqual($PARAM[dbtype],tvshow) + !Skin.HasSetting(InfoLine.tvshow.DisableStars)] | [!$PARAM[player] + String.IsEqual($PARAM[dbtype],season) + !Skin.HasSetting(InfoLine.season.DisableStars)] | [!$PARAM[player] + String.IsEqual($PARAM[dbtype],set) + !Skin.HasSetting(InfoLine.set.DisableStars)] | [[[!$PARAM[player] + String.IsEqual($PARAM[dbtype],episode)] | [$PARAM[player] + VideoPlayer.Content(episodes)]] + !Skin.HasSetting(InfoLine.episode.DisableStars)] | [[[!$PARAM[player] + String.IsEqual($PARAM[dbtype],video)] | [$PARAM[player] + !VideoPlayer.Content(movies) + !VideoPlayer.Content(episodes) + !VideoPlayer.Content(livetv)]] + !Skin.HasSetting(InfoLine.video.DisableStars)]]</param>
            </include>
            <include content="Info_Line_Labels" condition="!Skin.String(InfoTags.Style,Pill)">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="source">$PARAM[source]</param>
                <param name="dbtype">$PARAM[dbtype]</param>
                <param name="player">$PARAM[player]</param>
                <param name="item">Info_Line_Label</param>
            </include>
            <include content="Info_Line_Tags" condition="Skin.String(InfoTags.Style,Pill)">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="source">$PARAM[source]</param>
                <param name="dbtype">$PARAM[dbtype]</param>
                <param name="player">$PARAM[player]</param>
            </include>
        </definition>
    </include>

    <include name="InfoLine_Stars_Outline_U3k">
        <definition>
            <include content="Info_Line_StarRating_Outline_U3k">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="rating">$PARAM[source].Rating</param>
                <param name="visible">$PARAM[visible] + !String.IsEmpty($PARAM[source].Rating) + String.IsEmpty($PARAM[source].UserRating)</param>
            </include>
            <include content="Info_Line_StarRating_Outline_U3k">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="rating">$PARAM[source].UserRating</param>
                <param name="visible">$PARAM[visible] + !String.IsEmpty($PARAM[source].UserRating)</param>
            </include>
        </definition>
    </include>

    <include name="Info_Line_StarRating_Outline_U3k">
        <param name="font">font_tiny_bold_lines</param>
        <definition>
            <control type="group">
                <width>150</width>
                <visible>$PARAM[visible]</visible>
                <control type="label">
                    <label>&#x2002;&#x2003;&#x2003;&#x2003;&#x2003;&#x2003;&#x2003;&#x2000;</label>
                    <textcolor>$PARAM[colordiffuse]_90</textcolor>
                    <width>220</width>
                    <align>left</align>
                    <scroll>false</scroll>
                    <aligny>center</aligny>
                    <font>$PARAM[font]</font>
                </control>
                <include content="Info_StarRating">
                    <param name="colordiffuse">$PARAM[colordiffuse]_90</param>
                    <param name="rating">$PARAM[rating]</param>
                    <param name="size">40</param>
                    <height>40</height>
                    <width>136</width>
                    <left>6</left>
                    <centertop>50%</centertop>
                    <itemgap>-16</itemgap>
                </include>
            </control>
        </definition>
    </include>

    <include name="Info_Line_VideoQuality_Resolution_U3k">
        <param name="visible">true</param>
        <param name="playable">true</param>
        <definition>
            <include content="Info_Line_Pill_Text">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="label">8K</param>
                <param name="visible">$PARAM[visible] + $PARAM[playable] + $PARAM[is_8k]</param>
                <param name="width">60</param>
            </include>
            <include content="Info_Line_Pill_Text">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="label">4K Ultra HD</param>
                <param name="visible">$PARAM[visible] + $PARAM[playable] + !$PARAM[is_8k] + $PARAM[is_4k]</param>
                <param name="width">auto</param>
            </include>
            <include content="Info_Line_Pill_Text">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="label">Full HD</param>
                <param name="visible">$PARAM[visible] + $PARAM[playable] + !$PARAM[is_8k] + !$PARAM[is_4k] + $PARAM[is_fd]</param>
                <param name="width">auto</param>
            </include>
            <include content="Info_Line_Pill_Text">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="label">HD</param>
                <param name="visible">$PARAM[visible] + $PARAM[playable] + !$PARAM[is_8k] + !$PARAM[is_4k] + !$PARAM[is_fd] + $PARAM[is_hd]</param>
                <param name="width">60</param>
            </include>
            <include content="Info_Line_Pill_Text">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="label">SD</param>
                <param name="visible">$PARAM[visible] + $PARAM[playable] + !$PARAM[is_8k] + !$PARAM[is_4k] + !$PARAM[is_fd] + !$PARAM[is_hd] + $PARAM[is_sd]</param>
                <param name="width">60</param>
            </include>
            <include content="Info_Line_Pill_Icon">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="icon">flags/info-inverted.png</param>
                <param name="visible">$PARAM[visible] + [!$PARAM[playable] | [!$PARAM[is_8k] + !$PARAM[is_4k] + !$PARAM[is_fd] + !$PARAM[is_hd] + !$PARAM[is_sd]]]</param>
                <param name="width">60</param>
            </include>
        </definition>
    </include>

    <include name="Info_Line_VideoQuality_HDRType_U3k">
        <param name="visible">true</param>
        <definition>
            <include content="Info_Line_Pill_Text">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="label">Dolby Vision</param>
                <param name="visible">$PARAM[visible] + String.IsEqual($PARAM[source].HdrType,dolbyvision) + ![Skin.HasSetting(InfoTags.EnableAudioCodec) + [String.IsEqual($PARAM[source].AudioCodec,ac3) | String.IsEqual($PARAM[source].AudioCodec,dolbydigital) | String.IsEqual($PARAM[source].AudioCodec,eac3) | String.IsEqual($PARAM[source].AudioCodec,eac3_ddp_atmos) | String.IsEqual($PARAM[source].AudioCodec,truehd) | String.IsEqual($PARAM[source].AudioCodec,truehd_atmos)]]</param>
                <param name="width">auto</param>
            </include>
            <include content="Info_Line_Pill_Text">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="label">HDR10</param>
                <param name="visible">$PARAM[visible] + String.IsEqual($PARAM[source].HdrType,hdr10)</param>
                <param name="width">auto</param>
            </include>
            <include content="Info_Line_Pill_Text">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="label">HLG</param>
                <param name="visible">$PARAM[visible] + String.IsEqual($PARAM[source].HdrType,hlg)</param>
                <param name="width">auto</param>
            </include>
            <include content="Info_Line_Pill_Text">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="label">SDR</param>
                <param name="visible">$PARAM[visible] + String.IsEmpty($PARAM[source].HdrType) + !String.IsEmpty($PARAM[source].VideoResolution)</param>
                <param name="width">auto</param>
            </include>
            <include content="Info_Line_Pill_Text">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="label">Dolby Vision • TrueHD</param>
                <param name="visible">$PARAM[visible] + Skin.HasSetting(InfoTags.EnableAudioCodec) + String.IsEqual($PARAM[source].HdrType,dolbyvision) + String.IsEqual($PARAM[source].AudioCodec,truehd)</param>
                <param name="width">auto</param>
            </include>
            <include content="Info_Line_Pill_Text">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="label">Dolby Vision • TrueHD (Atmos)</param>
                <param name="visible">$PARAM[visible] + Skin.HasSetting(InfoTags.EnableAudioCodec) + String.IsEqual($PARAM[source].HdrType,dolbyvision) + String.IsEqual($PARAM[source].AudioCodec,truehd_atmos)</param>
                <param name="width">auto</param>
            </include>
            <include content="Info_Line_Pill_Text">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="label">Dolby Vision • Digital</param>
                <param name="visible">$PARAM[visible] + Skin.HasSetting(InfoTags.EnableAudioCodec) + String.IsEqual($PARAM[source].HdrType,dolbyvision) + [String.IsEqual($PARAM[source].AudioCodec,ac3) | String.IsEqual($PARAM[source].AudioCodec,dolbydigital)]</param>
                <param name="width">auto</param>
            </include>
            <include content="Info_Line_Pill_Text">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="label">Dolby Vision • Digital Plus</param>
                <param name="visible">$PARAM[visible] + Skin.HasSetting(InfoTags.EnableAudioCodec) + String.IsEqual($PARAM[source].HdrType,dolbyvision) + String.IsEqual($PARAM[source].AudioCodec,eac3)</param>
                <param name="width">auto</param>
            </include>
            <include content="Info_Line_Pill_Text">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="label">Dolby Vision • Digital Plus (Atmos)</param>
                <param name="visible">$PARAM[visible] + Skin.HasSetting(InfoTags.EnableAudioCodec) + String.IsEqual($PARAM[source].HdrType,dolbyvision) + String.IsEqual($PARAM[source].AudioCodec,eac3_ddp_atmos)</param>
                <param name="width">auto</param>
            </include>
        </definition>
    </include>

    <include name="Info_Line_AudioCodec_U3k">
        <param name="visible">true</param>
        <definition>
            <include content="Info_Line_Pill_Text">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="label">AAC</param>
                <param name="visible">$PARAM[visible] + [String.IsEqual($PARAM[source].AudioCodec,aac) | String.IsEqual($PARAM[source].AudioCodec,aac_latm) | String.IsEqual($PARAM[source].AudioCodec,aac_lc) | String.IsEqual($PARAM[source].AudioCodec,he_aac) | String.IsEqual($PARAM[source].AudioCodec,he_aac_v2) | String.IsEqual($PARAM[source].AudioCodec,aac_ssr) | String.IsEqual($PARAM[source].AudioCodec,aac_ltp)]</param>
                <param name="width">auto</param>
            </include>
            <include content="Info_Line_Pill_Text">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="label">Dolby Digital</param>
                <param name="visible">$PARAM[visible] + [String.IsEqual($PARAM[source].AudioCodec,ac3) | String.IsEqual($PARAM[source].AudioCodec,dolbydigital)] + ![Skin.HasSetting(InfoTags.EnableHDR) + String.IsEqual($PARAM[source].HdrType,dolbyvision)]</param>
                <param name="width">auto</param>
            </include>
            <include content="Info_Line_Pill_Text">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="label">DTS</param>
                <param name="visible">$PARAM[visible] + [String.IsEqual($PARAM[source].AudioCodec,dca) | String.IsEqual($PARAM[source].AudioCodec,dts)]</param>
                <param name="width">auto</param>
            </include>
            <include content="Info_Line_Pill_Text">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="label">DTS-HD</param>
                <param name="visible">$PARAM[visible] + String.IsEqual($PARAM[source].AudioCodec,dtshd)</param>
                <param name="width">auto</param>
            </include>
            <include content="Info_Line_Pill_Text">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="label">DTS-HD Master Audio</param>
                <param name="visible">$PARAM[visible] + String.IsEqual($PARAM[source].AudioCodec,dtshd_ma)</param>
                <param name="width">auto</param>
            </include>
            <include content="Info_Line_Pill_Text">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="label">DTS-HD HRA</param>
                <param name="visible">$PARAM[visible] + String.IsEqual($PARAM[source].AudioCodec,dtshd_hra)</param>
                <param name="width">auto</param>
            </include>
            <include content="Info_Line_Pill_Text">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="label">DTS:X</param>
                <param name="visible">$PARAM[visible] + String.IsEqual($PARAM[source].AudioCodec,dtshd_ma_x)</param>
                <param name="width">auto</param>
            </include>
            <include content="Info_Line_Pill_Text">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="label">DTS:X (IMAX)</param>
                <param name="visible">$PARAM[visible] + String.IsEqual($PARAM[source].AudioCodec,dtshd_ma_x_imax)</param>
                <param name="width">auto</param>
            </include>
            <include content="Info_Line_Pill_Text">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="label">Dolby Digital Plus</param>
                <param name="visible">$PARAM[visible] + String.IsEqual($PARAM[source].AudioCodec,eac3) + ![Skin.HasSetting(InfoTags.EnableHDR) + String.IsEqual($PARAM[source].HdrType,dolbyvision)]</param>
                <param name="width">auto</param>
            </include>
            <include content="Info_Line_Pill_Text">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="label">Dolby Digital Plus (Atmos)</param>
                <param name="visible">$PARAM[visible] + String.IsEqual($PARAM[source].AudioCodec,eac3_ddp_atmos) + ![Skin.HasSetting(InfoTags.EnableHDR) + String.IsEqual($PARAM[source].HdrType,dolbyvision)]</param>
                <param name="width">auto</param>
            </include>
            <include content="Info_Line_Pill_Text">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="label">FLAC</param>
                <param name="visible">$PARAM[visible] + String.IsEqual($PARAM[source].AudioCodec,flac)</param>
                <param name="width">auto</param>
            </include>
            <include content="Info_Line_Pill_Text">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="label">MP3</param>
                <param name="visible">$PARAM[visible] + [String.IsEqual($PARAM[source].AudioCodec,mp3) | String.IsEqual($PARAM[source].AudioCodec,mp3float)]</param>
                <param name="width">auto</param>
            </include>
            <include content="Info_Line_Pill_Text">
                <param name="colordiffuse">$PARAM[colordiffuse]</param>
                <param name="label">OGG</param>
                <param name="visible">$PARAM[visible] + String.IsEqual($PARAM[source].AudioCodec,ogg)</param>
                <param name="width">auto</param>
            </include>

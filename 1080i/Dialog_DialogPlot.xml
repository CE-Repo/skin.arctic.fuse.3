    <include name="DialogPlot_Textbox">
        <param name="textbox_visible">true</param>
        <param name="include_divider">true</param>
        <param name="include_top">false</param>
        <param name="include_closebutton">true</param>
        <definition>
            <control type="group">
                <include>Size_Group_Head</include>
                <include content="Part_HeadText">
                    <param name="id">$PARAM[head_id]</param>
                    <param name="label">$PARAM[header]</param>
                </include>
                <include condition="$PARAM[include_divider]">Part_Line</include>
                <include condition="$PARAM[include_closebutton]">Part_CloseButton</include>
            </control>
            <control type="group">
                <include>Size_Group_Body</include>
                <control type="group">
                    <include content="Object_Top" condition="$PARAM[include_top]">
                        <param name="top">60</param>
                    </include>
                    <include content="Part_PlotText">
                        <param name="id">$PARAM[text_id]</param>
                        <param name="textbox">$PARAM[textbox]</param>
                        <visible>$PARAM[textbox_visible]</visible>
                    </include>
                    <include content="Part_Scrollbar_Max">
                        <param name="id">61</param>
                        <param name="inset">false</param>
                        <include>$PARAM[include_movement]</include>
                        <visible>$PARAM[textbox_visible]</visible>
                    </include>
                </control>
            </control>
        </definition>
    </include>

    <include name="DialogPlot_Artwork">
        <param name="poster_icon">$VAR[Image_Overlay_Poster]</param>
        <param name="square_icon">$INFO[Window(Home).Property(TMDbHelper.ListItem.Base_Icon)]</param>
        <param name="c_logo_icon">$INFO[Window(Home).Property(TMDbHelper.ListItem.Base_Clearlogo)]</param>
        <param name="hidden_icon">true</param>
        <definition>
            <control type="group">
                <include>Size_Dialog_Pad</include>

                <!-- Hidden Images to Test Availability -->
                <control type="image" id="99981">
                    <texture background="true" colordiffuse="00ffffff">$PARAM[poster_icon]</texture>
                    <visible>$PARAM[hidden_icon]</visible>
                </control>
                <control type="image" id="99982">
                    <texture background="true" colordiffuse="00ffffff">$PARAM[square_icon]</texture>
                    <visible>$PARAM[hidden_icon]</visible>
                </control>

                <!-- Visible Images Based On Availability -->
                <control type="grouplist">
                    <orientation>vertical</orientation>
                    <itemgap>40</itemgap>
                    <control type="group">
                        <height>720</height>
                        <visible>!String.IsEmpty(Control.GetLabel(99981))</visible>
                        <include content="Part_Box_Outline">
                            <control type="image">
                                <aspectratio scalediffuse="false">scale</aspectratio>
                                <texture background="true" diffuse="diffuse/poster_w480_h720.png">$PARAM[poster_icon]</texture>
                            </control>
                        </include>
                    </control>
                    <control type="group">
                        <height>480</height>
                        <visible>String.IsEmpty(Control.GetLabel(99981))</visible>
                        <visible>!String.IsEmpty(Control.GetLabel(99982))</visible>
                        <include content="Part_Box_Outline">
                            <control type="image">
                                <aspectratio scalediffuse="false">keep</aspectratio>
                                <texture background="true" diffuse="diffuse/square_w480_h480.png">$PARAM[square_icon]</texture>
                            </control>
                        </include>
                    </control>
                    <control type="group">
                        <height>200</height>
                        <visible>String.IsEmpty(Control.GetLabel(99981))</visible>
                        <control type="image">
                            <aspectratio scalediffuse="false" aligny="center">keep</aspectratio>
                            <texture background="true">$PARAM[c_logo_icon]</texture>
                        </control>
                    </control>
                </control>
            </control>
        </definition>
    </include>

    <include name="DialogPlot_OnMove">
        <onright>PreviousMenu</onright>
        <onleft>PreviousMenu</onleft>
        <showonepage>true</showonepage>
    </include>

    <include name="DialogCustomPlot_OnMove">
        <onup>9000</onup>
        <onleft>9000</onleft>
        <onright>9000</onright>
        <showonepage>false</showonepage>
    </include>

    <include name="DialogPlot_Ratings_Layout">
        <param name="selected">false</param>
        <param name="property">ListItem.Property(Rating)</param>
        <definition>
            <control type="group">
                <visible>!String.IsEmpty(ListItem.Label)</visible>
                <right>10</right>
                <bottom>10</bottom>

                <control type="group">
                    <width>40</width>
                    <visible>Integer.IsEqual(ListItem.Property(Episode),1)</visible>
                    <control type="label">
                        <font>font_tiny_bold</font>
                        <align>center</align>
                        <textcolor>dialog_fg_90</textcolor>
                        <label>$INFO[ListItem.Property(Season)]</label>
                    </control>
                </control>

                <control type="group">
                    <left>40</left>
                    <right>-40</right>
                    <control type="image">
                        <colordiffuse>rating_9</colordiffuse>
                        <texture border="20">common/box.png</texture>
                        <visible>!Integer.IsLess($PARAM[property],9)</visible>
                    </control>
                    <control type="image">
                        <colordiffuse>rating_8</colordiffuse>
                        <texture border="20">common/box.png</texture>
                        <visible>Integer.IsLess($PARAM[property],9)</visible>
                        <visible>!Integer.IsLess($PARAM[property],8)</visible>
                    </control>
                    <control type="image">
                        <colordiffuse>rating_7</colordiffuse>
                        <texture border="20">common/box.png</texture>
                        <visible>Integer.IsLess($PARAM[property],8)</visible>
                        <visible>!Integer.IsLess($PARAM[property],7)</visible>
                    </control>
                    <control type="image">
                        <colordiffuse>rating_6</colordiffuse>
                        <texture border="20">common/box.png</texture>
                        <visible>Integer.IsLess($PARAM[property],7)</visible>
                        <visible>!Integer.IsLess($PARAM[property],6)</visible>
                    </control>
                    <control type="image">
                        <colordiffuse>rating_5</colordiffuse>
                        <texture border="20">common/box.png</texture>
                        <visible>Integer.IsLess($PARAM[property],6)</visible>
                        <visible>!Integer.IsLess($PARAM[property],5)</visible>
                    </control>
                    <control type="image">
                        <colordiffuse>rating_4</colordiffuse>
                        <texture border="20">common/box.png</texture>
                        <visible>Integer.IsLess($PARAM[property],5)</visible>
                        <visible>!Integer.IsLess($PARAM[property],4)</visible>
                    </control>
                    <control type="image">
                        <colordiffuse>rating_3</colordiffuse>
                        <texture border="20">common/box.png</texture>
                        <visible>Integer.IsLess($PARAM[property],4)</visible>
                    </control>

                    <control type="group">
                        <control type="label">
                            <font>font_hint_bold</font>
                            <textcolor>panel_bg_90</textcolor>
                            <label>$INFO[ListItem.Property(Season),S,]$INFO[ListItem.Property(Episode),E,]</label>
                            <align>left</align>
                            <top>10</top>
                            <left>10</left>
                            <height>10</height>
                        </control>

                        <control type="group">
                            <left>10</left>
                            <height>20</height>
                            <bottom>10</bottom>
                            <right>10</right>
                            <control type="label">
                                <font>font_midi_bold</font>
                                <textcolor>panel_bg_90</textcolor>
                                <label>$INFO[$PARAM[property]]</label>
                                <align>right</align>
                            </control>
                        </control>
                    </control>
                </control>
            </control>
        </definition>
    </include>

    <variable name="DialogPlot_Ratings_Path">
        <value condition="!Integer.IsEqual(Container(8001).NumItems,0) + !Container(8001).IsUpdating">$INFO[Container(8001).NumItems,plugin://script.skinvariables/?info=get_panel_labels&amp;container=8001&amp;infolabel=Season&amp;length=8&amp;infoproperties=Season/Season//Episode/Episode//Rating/Rating&amp;numitems=,]</value>
    </variable>

    <include name="DialogPlot_Ratings_Legend">
        <control type="image">
            <colordiffuse>$PARAM[colordiffuse]</colordiffuse>
            <texture>common/box.png</texture>
            <width>30</width>
            <height>30</height>
        </control>
        <control type="label">
            <font>font_hint</font>
            <textcolor>dialog_fg_90</textcolor>
            <label>$PARAM[label]</label>
            <width>auto</width>
            <height>30</height>
            <aligny>center</aligny>
        </control>
        <control type="group">
            <width>10</width>
        </control>
    </include>


    <include name="DialogPlot_Ratings">
        <param name="textbox_visible">true</param>
        <param name="include_divider">true</param>
        <param name="include_top">false</param>
        <param name="include_closebutton">true</param>
        <definition>
            <control type="group">
                <include>Size_Group_Head</include>
                <include content="Part_HeadText">
                    <param name="id">$PARAM[head_id]</param>
                    <param name="label">$PARAM[header]</param>
                </include>
                <include condition="$PARAM[include_divider]">Part_Line</include>
                <include condition="$PARAM[include_closebutton]">Part_CloseButton</include>
            </control>
            <control type="group">
                <include>Size_Group_Body</include>
                <control type="group">
                    <include content="Object_Top" condition="$PARAM[include_top]">
                        <param name="top">60</param>
                    </include>
                    <control type="group">
                        <include>Size_Dialog_Pad</include>

                        <!-- Hidden list with data -->
                        <control type="list" id="8001">
                            <include>Object_Hidden_List_Definition</include>
                            <content>plugin://plugin.video.themoviedb.helper/?info=flatseasons&amp;tmdb_id=$INFO[Window(Home).Property(TMDBHelper.ListItem.Monitor.TMDb_ID)]&amp;tmdb_type=tv</content>
                        </control>

                        <!-- While loading show panel placeholders -->
                        <control type="panel">
                            <orientation>vertical</orientation>
                            <right>-10</right>
                            <bottom>40</bottom>
                            <itemlayout width="111.25" height="80">
                                <control type="image">
                                    <visible>!String.IsEmpty(ListItem.Label)</visible>
                                    <right>10</right>
                                    <bottom>10</bottom>
                                    <colordiffuse>dialog_fg_12</colordiffuse>
                                    <texture border="20">common/box.png</texture>
                                </control>
                            </itemlayout>
